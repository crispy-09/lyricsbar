<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.crispy.touchbar-lyrics</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__HOME__/.touchbar-lyrics/lyricsd.py</string></array>
  <key>AssociatedBundleIdentifiers</key><array><string>com.crispy.lyricsbar</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/.touchbar-lyrics/error.log</string>
</dict></plist>
